# cp .env.example .env, fill in real values, then `source .env` before
# running any terraform command. .env is gitignored, this file isn't.

export PROXMOX_VE_ENDPOINT="https://<proxmox-host>:8006/"
export PROXMOX_VE_API_TOKEN="terraform@pve!tf-token=<token-secret>"

# Proxmox's default cert is self-signed. Fine for a homelab node behind
# a home network, would use a real cert for anything internet-facing.
export PROXMOX_VE_INSECURE="true"

# Public key only, injected into new VMs via cloud-init. Never the
# private key.
export TF_VAR_ssh_public_key="ssh-ed25519 AAAA... you@yourmac"
