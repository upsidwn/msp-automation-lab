# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets - never commit real credentials
.env
*.env
!*.env.example

# OS junk
.DS_Store

# Collector output - real device data (serials, IPs, etc), never commit.
# Wildcarded, not extension-specific: diagram.py's .png and
# config-backup-system's timestamped files already showed one-extension-
# at-a-time patterns miss the next new output format.
lab/*/output/*
production/*/output/*

# Local device lists for run.py --devices-file (real IPs), never commit
lab/*/devices/
production/*/devices/

# Ansible real inventory/vault (real IPs, encrypted-or-not creds), never
# commit. Structural, not filename-specific: Ansible accepts any
# inventory filename/extension, and host_vars is a normal sibling of
# group_vars, a hardcoded "hosts.yml" pattern would miss all of those.
lab/*/source/inventory/*
!lab/*/source/inventory/*.example
production/*/source/inventory/*
!production/*/source/inventory/*.example
lab/*/source/group_vars/*/vault.*
!lab/*/source/group_vars/*/vault.*.example
lab/*/source/host_vars/*/vault.*
!lab/*/source/host_vars/*/vault.*.example
production/*/source/group_vars/*/vault.*
!production/*/source/group_vars/*/vault.*.example
production/*/source/host_vars/*/vault.*
!production/*/source/host_vars/*/vault.*.example
