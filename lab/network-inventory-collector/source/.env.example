# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

NIC_JUNOS_HOST=

# Credential pool -- add as many NIC_CRED_N_USER/PASS pairs as you have
# known credential sets. Tried in order against each device; if none
# work, the tool prompts you interactively and remembers it for the
# rest of that run only (never written back to this file).
NIC_CRED_1_USER=
NIC_CRED_1_PASS=

# UniFi Network Integration API -- key-based auth, separate from the
# SSH credential pool above. Generate the key from the console's own
# UI (Settings -> Integrations / API), scoped read-only if possible.
NIC_UNIFI_HOST=
NIC_UNIFI_API_KEY=
