# Copy this file to .env and fill in real values. .env itself is gitignored,
# never commit it.

# Single Juniper device (collect.py, connect_test.py)
NIC_JUNOS_HOST=192.0.2.10

# Credential pool, tried in order against any SSH vendor (Juniper/EXOS).
# Add NIC_CRED_2_USER/PASS, NIC_CRED_3_USER/PASS, etc for more.
NIC_CRED_1_USER=admin
NIC_CRED_1_PASS=changeme

# UniFi controller (collect_unifi.py), key generated from the console's own UI
NIC_UNIFI_HOST=192.0.2.20
NIC_UNIFI_API_KEY=your-api-key-here
