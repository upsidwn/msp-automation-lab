# cp secret.yaml.example secret.yaml, fill in real values, then
# `kubectl apply -f secret.yaml`. secret.yaml itself is gitignored,
# same as .env - never commit real values here.
apiVersion: v1
kind: Secret
metadata:
  name: collector-creds
type: Opaque
stringData:
  NIC_CRED_1_USER: admin
  NIC_CRED_1_PASS: changeme
  NIC_UNIFI_HOST: 192.0.2.20
  NIC_UNIFI_API_KEY: your-api-key-here
  NIC_SCAN_CIDR: 192.0.2.0/24
